# Copy to .env and fill in as needed. Expo automatically inlines any
# EXPO_PUBLIC_* variable at build time (SDK 49+) — no extra tooling needed.
#
# The prototype stays on local mocks by default. Set
# EXPO_PUBLIC_USE_MOCK_API=false to exercise the real API path.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Defaults to https://longlivy.digitallhut.com/api/v1
EXPO_PUBLIC_API_BASE_URL=

# true | false (the explicit local-mock switch)
EXPO_PUBLIC_USE_MOCK_API=true

# Request timeout in milliseconds (default 15000)
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Verbose request/response console logging in dev builds (default true; always off in production)
EXPO_PUBLIC_API_LOGGING=true
