# Copy to .env and fill in as needed. Expo automatically inlines any
# EXPO_PUBLIC_* variable at build time (SDK 49+) — no extra tooling needed.
#
# Leave EXPO_PUBLIC_API_BASE_URL unset to keep running on the local mock
# repositories (the default for this prototype). Set it once a real backend
# exists to switch auth (and, feature by feature, everything else) over to
# the real API — see API_MIGRATION.md.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# e.g. https://api.longlivy.app/api
EXPO_PUBLIC_API_BASE_URL=

# Request timeout in milliseconds (default 15000)
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Verbose request/response console logging in dev builds (default true; always off in production)
EXPO_PUBLIC_API_LOGGING=true
