    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@reduxjs/toolkit": "^2.2.5",
    "axios": "^1.19.0",
    "expo": "^57.0.14",
    "expo-asset": "~57.0.13",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "^57.0.15",
    "expo-camera": "~57.0.3",
    "expo-file-system": "~57.0.5",
    "expo-image-picker": "~57.0.11",
    "expo-linear-gradient": "~57.0.1",
    "expo-location": "~57.0.11",
